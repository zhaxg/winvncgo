# ===== 构建产物 =====
# Wails 构建输出（二进制 + 复制的 UltraVNC 依赖），可随时用 build.ps1 重建
build/bin/
# Windows 7 发行包（build.ps1 win7）与 WebView2 固定版本运行时下载缓存
dist/
build/webview2-runtime/
# Wails 生成的 Windows 资源（icon.ico 由 appicon.png 构建时自动重建）
build/windows/icon.ico
# Go 编译的临时资源对象文件（Wails 构建后自动删除，若残留则忽略）
*-res.syso

# ===== 运行时 / 本机文件 =====
*.log
# dev 模式从根目录运行时可能在根目录产生的运行时痕迹
/ultravnc.portable
# 运行时配置：含本机控制中心地址与口令，不入库（分发模板是 libs/wegovnc.json）
/wegovnc.json

# ===== Go =====
*.test
*.out
*.prof

# ===== 前端 =====
node_modules/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*~

# ===== 操作系统 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 工具链 =====
.code-graph/
/libs/ultravnc

# ===== 调研临时文件 =====
.research_tmp/
